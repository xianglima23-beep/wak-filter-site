\"Submit\",\"feedback_prompt\":\"\",\"feedback_title\":\"\",\"feedback_textarea_1_placeholder_text\":\"\",\"feedback_opt_in_label\":\"\"},\"is_device_based\":false,\"passed\":false},\"944963740\":{\"name\":\"944963740\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1947723669\":{\"name\":\"1947723669\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":16,\"id_type\":\"stableID\",\"value\":{},\"is_device_based\":true,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1623104352\":{\"name\":\"1623104352\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":25,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2826703856\":{\"name\":\"2826703856\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1355972088\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"949606265\",\"gateValue\":\"false\",\"ruleID\":\"2lpDcuUELYXUMUbCWLWWvc\"},{\"gate\":\"1475533758\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":134,\"id_type\":\"workspace_id\",\"value\":{\"enable_combined_rbac_page\":true},\"is_device_based\":false,\"passed\":false},\"4005134340\":{\"name\":\"4005134340\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1007700932\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":17,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"2076138851\":{\"name\":\"2076138851\",\"rule_id\":\"GDz2jLo44570oZBwbDQ4Mp\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"max_concurrency\":5},\"is_device_based\":false,\"group_name\":\"5\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"3406517345\":{\"name\":\"3406517345\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":23,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"3165814200\":{\"name\":\"3165814200\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"JITTER_MINIMUM\":0.5,\"JITTER_MAXIMUM\":1,\"MAX_RETRY_COUNT\":12,\"RETRY_FACTOR\":1.5,\"MIN_RETRY_INTERVAL\":300,\"MAX_RETRY_INTERVAL\":5000},\"is_device_based\":false,\"passed\":false},\"1939873467\":{\"name\":\"1939873467\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Live-only update\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"2214612631\":{\"name\":\"2214612631\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{\"trigger_words\":[\"messi\",\"soccer\",\"FIFA\",\"World Cup\"]},\"is_device_based\":false,\"passed\":false},\"3792512848\":{\"name\":\"3792512848\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"payment_method_instrumentation_type\":{\"paypal\":\"full_redirect\",\"pix\":\"partial_redirect\"}},\"is_device_based\":false,\"passed\":false},\"3055066993\":{\"name\":\"3055066993\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":9,\"id_type\":\"userID\",\"value\":{\"enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1104813507\":{\"name\":\"1104813507\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"options\":[{\"key\":\"image_card_v1\",\"label\":\"ImageCardV1\"},{\"label\":\"ImageCardV2: Single\",\"key\":\"image_card_v2_single\"},{\"key\":\"image_card_v2_two\",\"label\":\"ImageCardV2: Two\"},{\"key\":\"image_card_v2_five\",\"label\":\"ImageCardV2: Five\"},{\"key\":\"image_card_v2_cta\",\"label\":\"ImageCardV2: CTA\"},{\"key\":\"product_card_v2_single\",\"label\":\"ProductCardV2: Single\"},{\"key\":\"product_card_v2_two_horizontal\",\"label\":\"ProductCardV2: Two Horizontal\"},{\"key\":\"product_card_v2_two_vertical\",\"label\":\"ProductCardV2: Two Vertical\"},{\"label\":\"ProductCardV2: Four\",\"key\":\"product_card_v2_four\"},{\"label\":\"ProductCardV2: Five\",\"key\":\"product_card_v2_five\"},{\"label\":\"Temu 1\",\"key\":\"product_card_v2_temu_1\"},{\"key\":\"product_card_v2_temu_2\",\"label\":\"Temu 2\"},{\"key\":\"product_card_v2_temu_3\",\"label\":\"Temu 3\"},{\"label\":\"Personalized Ads MVP 1\",\"key\":\"image_card_v2_personalized_ads_mvp_1\"},{\"label\":\"Personalized Ads MVP 2\",\"key\":\"image_card_v2_personalized_ads_mvp_2\"}]},\"is_device_based\":false,\"passed\":false},\"3359927663\":{\"name\":\"3359927663\",\"rule_id\":\"4PJfVH44agUI1KA3nvdZUW:30.00:8-6zr8aU9VHNUkRPlG8CwXPB\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"stableID\",\"value\":{\"enabled\":true,\"max_pending_update_header_size_bytes\":16384},\"is_device_based\":true,\"passed\":true},\"1299917208\":{\"name\":\"1299917208\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"stableID\",\"value\":{\"handoff_link_strategy\":\"legacy_root\"},\"is_device_based\":true,\"passed\":false},\"1800637375\":{\"name\":\"1800637375\",\"rule_id\":\"1t8E34IgQR6ODV93aC9Ley\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\"],\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"3421588596\":{\"name\":\"3421588596\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"userID\",\"value\":{\"default_average_monthly_credits_per_member\":400},\"is_device_based\":false,\"passed\":false},\"605519219\":{\"name\":\"605519219\",\"rule_id\":\"targetingGate\",\"secondary_exposures\":[{\"gate\":\"895740524\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":13,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"3941338778\":{\"name\":\"3941338778\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"enabled\":false,\"enabledConnectors\":[]},\"is_device_based\":false,\"passed\":false},\"365985288\":{\"name\":\"365985288\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":6,\"id_type\":\"stableID\",\"value\":{\"pioneer\":[],\"maverick\":[],\"stratos\":[],\"trailblazer\":[],\"seeker\":[],\"wayfinder\":[]},\"is_device_based\":true,\"passed\":false},\"2133596510\":{\"name\":\"2133596510\",\"rule_id\":\"USeZB9iWAKvIVlivpomby\",\"secondary_exposures\":[],\"version\":20,\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1355628363\":{\"name\":\"1355628363\",\"rule_id\":\"6Ejs5ZDWZjxqVj3jfEBlQn:100.00:4-6Ejs5XYUx1nWBTvnEwFIxl\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"stableID\",\"value\":{\"prompts\":[{\"body\":\"Roleplay a friendly interviewer for a job I’m preparing for. Ask me the role first, then give one question at a time and quick feedback.\",\"title\":\"Practice an interview round\"},{\"body\":\"Help me rewrite a short message in a voice that sounds warm, clear, and like me. Ask me for the draft and the audience.\",\"title\":\"Find my writing voice\"},{\"body\":\"Create a text-light heat day plan with icons for shade, water, breaks, cooling, and weather checks. Leave room for my schedule.\",\"title\":\"Make a heat day plan\"},{\"body\":\"Help me make a zero-proof summer spritz. Ask what fruit or herbs I have, then give a crisp recipe and a batch version.\",\"title\":\"Mix a zero-proof spritz\"},{\"title\":\"Create a time capsule card\",\"body\":\"Create a text-light printable time capsule card for America250 with simple archival icons and blank lines for notes.\"},{\"title\":\"Make a Derby scorecard\",\"body\":\"Make a simple Home Run Derby scorecard I can use with friends. Include casual rules, blank spaces for picks, and a fun scoring twist.\"},{\"title\":\"Build a zero-proof spritz bar\",\"body\":\"Help me set up a zero-proof spritz bar for summer. Give me flavor combos, a shopping list, and a batching plan for guests.\"},{\"title\":\"Plan Rocky Mountain entry\",\"body\":\"I'm planning a day at Rocky Mountain National Park this summer. Ask me which date and area, then make an entry plan around the 2026 timed-entry rules.\"},{\"body\":\"Create an image of a simple dinner decision wheel from ingredients I list or show. I can upload a photo or list them. Keep labels blank.\",\"title\":\"Draw my dinner decision wheel\"},{\"title\":\"Create a baseball bingo card\",\"body\":\"Create a clean, text-light baseball bingo card with 5x5 blank squares and simple field icons. Avoid team logos.\"},{\"title\":\"Practice a hard conversation\",\"body\":\"Help me practice a respectful conversation. Ask what I need to say, then role-play the other person and coach my wording.\"},{\"title\":\"Plan a July 4 mini-adventure\",\"body\":\"Make a low-key Independence Day mini-adventure for the long weekend. Ask one question about my town or vibe, then suggest a playful plan.\"},{\"body\":\"Create a text-light set of backyard game cards for July 4, using simple summer icons, blank labels, and no logos.\",\"title\":\"Create backyard game cards\"},{\"title\":\"Pick Wimbledon matches to watch\",\"body\":\"Use the latest Wimbledon schedule to suggest a few matches to follow. Ask my time zone if you need it.\"},{\"title\":\"Plan a cool errand loop\",\"body\":\"Help me turn hot-weather errands into a cooler route with shade breaks, water reminders, and a backup plan. Ask for my city if needed.\"},{\"body\":\"Help me rehearse a difficult conversation with calm wording and possible replies. Ask me who it’s with and the goal.\",\"title\":\"Rehearse a hard conversation\"},{\"body\":\"Create a text-light Summerween snack table image with pumpkins, popsicles, and spooky-sunny colors. No movie characters or logos.\",\"title\":\"Create a Summerween snack scene\"},{\"title\":\"Sketch my meal prep flow\",\"body\":\"Create a simple, text-light meal prep visual from what I have. I can upload a fridge photo or list ingredients. Ask for ingredients and timing first.\"},{\"body\":\"Help me learn enough about a destination to plan better. Ask where I’m going, then make a short guide to transit basics, food, etiquette, and what to verify.\",\"title\":\"Learn before you travel\"},{\"title\":\"Map a cycling watch board\",\"body\":\"Create a text-light cycling watch board with mountains, sprint, time trial, and rest-day icons. Leave blank spots for stage notes.\"},{\"title\":\"Prep mail before a trip\",\"body\":\"Help me prep my mail before a trip. Ask my travel dates, then compare USPS Hold Mail, Informed Delivery, and package delivery notes.\"},{\"body\":\"Explain a topic I’m curious about using a fresh analogy, a quick example, and one practice question. Ask me the topic.\",\"title\":\"Explain it with an analogy\"},{\"title\":\"Learn hurricane alert terms\",\"body\":\"Explain hurricane watch, warning, cone, surge, and evacuation zone in plain English. Ask my ZIP code only if local terms matter.\"},{\"title\":\"Draw my practice quest\",\"body\":\"Create a text-light visual quest map for a 7-day practice plan. Ask me what skill I’m learning and the final project I want.\"},{\"title\":\"Rewrite an email and learn why\",\"body\":\"I’ll paste an email draft. Rewrite it to be clearer and more useful, then explain three edits I can reuse next time.\"},{\"title\":\"Choose fruit nail art\",\"body\":\"Help me pick summer fruit nail art. Ask my nail length and how bold I want it, then give 5 simple ideas I can show a tech or DIY.\"},{\"title\":\"Build a 5-day learning plan\",\"body\":\"Build me a 5-day summer learning plan around one topic I choose. Ask for the topic first, then make it light and doable.\"},{\"title\":\"Map a froyo topping bar\",\"body\":\"Create a text-light frozen yogurt topping map with fruit, crunch, sauce, and savory-sweet sections. Use simple icons and blank labels.\"},{\"body\":\"Create a simple July Fourth potluck sign-up card with blank spaces for dishes, drinks, setup, and cleanup. Keep it text-light.\",\"title\":\"Make a potluck sign-up card\"},{\"title\":\"Practice for an interview\",\"body\":\"Help me practice for an interview. Ask what role I’m targeting, then run one question at a time and coach my answer structure.\"},{\"body\":\"Create a simple, text-light hurricane kit label sheet with icons for water, food, meds, flashlights, documents, pets, and blank spaces.\",\"title\":\"Make a storm kit label\"},{\"body\":\"Create a text-light produce storage label sheet for a summer market haul, with blank labels and simple icons for counter, fridge, and use soon.\",\"title\":\"Create produce storage labels\"},{\"body\":\"Create a text-light visual concept for refreshing one room with items I already own. I can upload a photo or describe the space.\",\"title\":\"Show a room refresh concept\"},{\"body\":\"Help me rewrite a message so it sounds clear and respectful. Ask me to paste the draft and name the outcome I want.\",\"title\":\"Polish a tricky email\"},{\"body\":\"Make me a two-week summer reading quest inspired by Unearth a Story, with prompts for books, local history, and one tiny artifact.\",\"title\":\"Build a summer reading quest\"},{\"title\":\"Create a book bingo card\",\"body\":\"Create a text-light summer reading bingo card with beach icons, blank squares, and space to add my own book titles.\"},{\"title\":\"Turn a walk into a field trip\",\"body\":\"Turn an ordinary walk near me into a mini field trip with things to notice and a reflection prompt. Ask me for the neighborhood or park.\"},{\"body\":\"Turn one resume bullet into a stronger achievement statement. Ask me for the bullet and the result or metric if I have one.\",\"title\":\"Make my resume bullet stronger\"},{\"title\":\"Speak soccer for the Cup\",\"body\":\"Teach me 12 soccer terms I’ll hear during the World Cup, with one plain-English example for each.\"},{\"title\":\"Plan a July 4 cookout\",\"body\":\"Help me plan a July 4 cookout menu and timeline. Ask one question about guests or dietary needs before you tailor it.\"},{\"body\":\"Help me turn a vague meeting goal into a useful agenda. Ask the goal, then draft talking points and explain why each part matters.\",\"title\":\"Turn a goal into an agenda\"},{\"title\":\"Plan groceries with less waste\",\"body\":\"Help me plan groceries for the week so fewer items go unused. Ask how many dinners I need and what I already have.\"},{\"title\":\"Make a World Cup watch game\",\"body\":\"Build a playful watch-party game for a 2026 World Cup match. Ask which teams I’m watching, then give easy rules and a few goofy bonus points.\"},{\"title\":\"Create a soccer bingo card\",\"body\":\"Create a text-light soccer bingo card for a 2026 World Cup watch party, with simple icons, blank squares, and no team logos.\"},{\"title\":\"Style a soccer-watch outfit\",\"body\":\"Help me make a soccer-watch outfit from what I own. I can upload a closet photo or describe pieces. Keep it logo-free and comfortable.\"},{\"title\":\"Remix hot dog night\",\"body\":\"Give me a playful Spam hot dog remix with one classic, one spicy, and one surprise topping combo.\"},{\"body\":\"Create a text-light soccer watch poster with blank team spaces, kickoff icons, snack doodles, no logos, and a fun living-room vibe.\",\"title\":\"Make a soccer watch poster\"},{\"title\":\"Shop the tax-free maze\",\"body\":\"Ask what state I’m shopping in, then check current back-to-school tax holiday dates and turn my supply list into a store quest.\"},{\"title\":\"Make a blank soccer bracket\",\"body\":\"Create a text-light blank soccer knockout bracket I can fill in during the 2026 World Cup, using simple field lines and no logos.\"},{\"body\":\"Plan road-trip snacks around real stops. Ask my route first, then make a cooler-friendly snack plan and a safe-break rhythm.\",\"title\":\"Make a road-trip snack map\"},{\"body\":\"Create a text-light nail inspo sheet with 5 fruit-color swatches, simple icons, blank labels, and no hands or brand logos.\",\"title\":\"Make a nail inspo sheet\"},{\"title\":\"Join the couch peloton\",\"body\":\"Turn a Tour de France stage into a couch-peloton game with team names, snack-zone rules, and a tiny glossary for a new fan.\"},{\"title\":\"Tame one messy spot\",\"body\":\"Help me turn one messy spot into a 20-minute cleanup game. I can upload a photo or describe the area.\"},{\"body\":\"Turn something I need to learn into a 25-minute quest with checkpoints, a tiny reward, and one self-quiz. Ask me the topic first.\",\"title\":\"Turn studying into a quest\"},{\"body\":\"Create an image of a text-light pantry meal formula card with simple food icons and blank labels for protein, vegetable, starch, and sauce.\",\"title\":\"Create a pantry formula card\"},{\"title\":\"Understand mail forwarding\",\"body\":\"Teach me the difference between USPS change of address, mail forwarding, and hold mail. Ask whether I’m moving or traveling first.\"},{\"body\":\"Help me choose between everyday options by turning them into safe, bold, and balanced scenarios. Ask me what I’m deciding.\",\"title\":\"Make an everyday decision\"},{\"title\":\"Turn notes into a study plan\",\"body\":\"I’ll paste messy notes. Turn them into a study plan with key ideas, gaps to clarify, and a short practice exercise.\"},{\"title\":\"Pick Tour de France stages\",\"body\":\"Help me pick five Tour de France stages to watch this year and explain the drama of each in plain English.\"},{\"body\":\"Help me decide whether US Open Fan Week is worth a visit, with what is free, what needs a pass, and what to check before going.\",\"title\":\"Plan a US Open Fan Week visit\"},{\"title\":\"Check school tax holiday rules\",\"body\":\"Ask my state first, then check whether there's a back-to-school sales tax holiday and make a school-supply shopping plan.\"},{\"body\":\"Give me a playful guide to the next World Cup match, with the stakes, one player to watch, and a silly chant idea. Ask who I’m rooting for.\",\"title\":\"Catch the World Cup vibe\"},{\"body\":\"Create a cheerful, text-light ice cream menu board for National Ice Cream Day with blank flavor spaces and simple topping icons.\",\"title\":\"Create an ice cream menu\"},{\"title\":\"Decode the bin mystery\",\"body\":\"Upload a package photo or name the item and my city. Help me figure out trash, recycling, compost, or drop-off without guesswork.\"},{\"body\":\"Create a text-light image of simple fruit nail ideas with blueberry, watermelon, cherry, lemon, and peach motifs. No brand logos.\",\"title\":\"Create fruit nail inspo\"},{\"title\":\"Price a garage-sale table\",\"body\":\"Help me price a garage-sale table like a game, with fair bundles, simple signs, and polite haggling lines.\"},{\"body\":\"Create a simple image of a hurricane kit shelf with blank zones for water, lights, batteries, chargers, first aid, and documents.\",\"title\":\"Create a storm-kit shelf guide\"},{\"title\":\"Make a 250-year time capsule\",\"body\":\"Help me make a small America250 time capsule: 10 items, one letter prompt, and a way to revisit it later.\"},{\"title\":\"Pick a fruit nail vibe\",\"body\":\"Help me choose a summer fruit nail vibe. Compare blueberry, watermelon, cherry, lemon, and peach in a playful way.\"},{\"body\":\"Make a July Fourth cookout timeline with food safety checkpoints and a simple prep order. Ask how many people before sizing the food.\",\"title\":\"Plan a July Fourth cookout\"},{\"title\":\"Draft a reply that sounds like me\",\"body\":\"Help me reply to a message with warmth and a little wit. I’ll paste the message, and you can ask what tone I want if it’s unclear.\"},{\"title\":\"Make All-Star Game bingo\",\"body\":\"Make a baseball bingo card for MLB All-Star Week with plays, broadcast moments, and funny but friendly squares.\"},{\"title\":\"Find a summer reading path\",\"body\":\"Help me turn a public library summer reading program into a simple reading plan. Ask my library system or city first.\"},{\"title\":\"Make a packing visual\",\"body\":\"Create a text-light packing visual for my trip. Ask for the destination and trip length first, then make it easy to scan.\"},{\"title\":\"Turn notes into a meeting recap\",\"body\":\"Turn my rough meeting notes into a concise recap with decisions, owners, and next steps. Ask me to paste the notes first.\"},{\"body\":\"I’ll paste a recipe step. Teach me the technique behind it, what to watch for, and how to tell when it’s done.\",\"title\":\"Understand a recipe step\"},{\"body\":\"Use the latest 2026 World Cup bracket to teach me how the knockout rounds work and what to watch for in the next match.\",\"title\":\"Understand the World Cup bracket\"},{\"body\":\"Explain kWh, rate, fees, and smart meter in a US electric bill. If I paste line items, translate them into plain English.\",\"title\":\"Decode an electric bill\"},{\"body\":\"Help me choose a vacation read by asking one question, then give me 5 playful picks by mood with a beach-bag rating.\",\"title\":\"Pick a vacation read\"},{\"body\":\"Plan a low-key Wimbledon breakfast watch: easy menu, scoring cheat sheet, and a friendly intro for someone new to tennis.\",\"title\":\"Host a Wimbledon breakfast\"},{\"title\":\"Catch up before Spider-Man\",\"body\":\"Make a spoiler-light catch-up plan before Spider-Man: Brand New Day. Include only the movies or scenes that matter most.\"},{\"title\":\"Pick a crochet summer project\",\"body\":\"I can upload a crochet inspiration photo or describe what I want to make. Help me pick yarn, estimate time, and plan first steps.\"},{\"title\":\"Turn notes in